# Logging
# ERROR_LOG=          # Path to append error/log output (Go binary -error-log flag).
#                     # When set, all log lines go to both stderr and this file.
#                     # Example: ERROR_LOG=logs/errors/scraper.log
# LOG_DIR=logs/gta-sweep  # Directory for gta-sweep.sh run logs (one file per run).
