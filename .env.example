# Control UI auth (both required — UI returns 503 if either is unset)
# CONTROL_USERNAME=admin
# CONTROL_PASSWORD=changeme

# Database output (optional; required when using "database" output mode in the UI)
# DSN=
# STATE_DB=gmdata/scraper-state.sqlite
# QUERIES=restaurants,bubble tea,cafes,bars,food courts,takeout restaurants,chinese restaurants,korean restaurants,japanese restaurants,vietnamese restaurants,thai restaurants,indian restaurants,pizza,sushi,ramen,pho,dim sum
# CORRIDOR_QUERIES=restaurants,bubble tea,cafes,bars,ramen,sushi,pho,dim sum,boba,korean bbq,vietnamese,taiwanese,izakaya,brunch,dessert cafe
# DEPTH=15
# MAXIMUM_CONCURRENCY=8
# REVIEWS=30
# BROAD_SLEEP=3h
# CORRIDOR_SLEEP=45m

# Logging
# ERROR_LOG=          # Path to append error/log output (Go binary -error-log flag).
#                     # When set, all log lines go to both stderr and this file.
#                     # Example: ERROR_LOG=logs/errors/scraper.log
# LOG_DIR=logs/gta-sweep  # Directory for gta-sweep.sh run logs (one file per run).
